# Personal data (never commit)
memory/me.md
memory/lessons.md
memory/roles.md
memory/log.md
.claude/settings.local.json

# Raw source documents (large files, not version-controlled by default)
raw/*
!raw/.gitkeep

# Graphify extraction cache (regenerable). The rest of graphify-out/ is committed.
graphify-out/cache/

# Secrets
.env
.env.*
secrets/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
